# Root environment variables
NODE_ENV=development

# Backend
DATABASE_URL=postgresql://cybershield:cybershield_secret@localhost:5432/cybershield_db
JWT_SECRET=your_super_secure_jwt_secret_key_minimum_32_chars
JWT_REFRESH_SECRET=your_super_secure_refresh_secret_key_minimum_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
PORT=3001
FRONTEND_URL=http://localhost:3000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001

# Email (Optional - for OTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
